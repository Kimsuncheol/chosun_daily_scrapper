{
  "components": {
    "responses": {
      "DEFAULT_ERROR": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Default error response"
      }
    },
    "schemas": {
      "Article": {
        "additionalProperties": false,
        "properties": {
          "authors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "body": {
            "nullable": true,
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "first_seen_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "last_seen_at": {
            "format": "date-time",
            "type": "string"
          },
          "modified_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "section": {
            "nullable": true,
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "format": "url",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ArticlePage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Article"
            },
            "type": "array"
          },
          "page": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Error code",
            "type": "integer"
          },
          "errors": {
            "additionalProperties": {},
            "description": "Errors",
            "type": "object"
          },
          "message": {
            "description": "Error message",
            "type": "string"
          },
          "status": {
            "description": "Error name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PaginationMetadata": {
        "additionalProperties": false,
        "properties": {
          "first_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "next_page": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "previous_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Run": {
        "additionalProperties": false,
        "properties": {
          "deferred": {
            "type": "integer"
          },
          "discovered": {
            "type": "integer"
          },
          "error": {
            "nullable": true,
            "type": "string"
          },
          "failed": {
            "type": "integer"
          },
          "finished_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "inserted": {
            "type": "integer"
          },
          "processed": {
            "type": "integer"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "succeeded",
              "partial",
              "failed"
            ],
            "type": "string"
          },
          "updated": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Chosun Daily Articles API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Open the browser-based API test website.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/articles": {
      "get": {
        "description": "Date bounds require a timezone. Unknown publication dates appear last.\nSearch matches literal title or description text, case insensitively.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "section",
            "required": false,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Inclusive ISO 8601 timestamp with timezone.",
            "in": "query",
            "name": "published_from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Exclusive ISO 8601 timestamp with timezone.",
            "in": "query",
            "name": "published_to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlePage"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "description": "Invalid pagination, filters, or date range"
          },
          "503": {
            "description": "Database unavailable"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "List articles, newest publication first.",
        "tags": [
          "articles"
        ]
      }
    },
    "/api/v1/articles/{article_id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "description": "Article not found"
          },
          "503": {
            "description": "Database unavailable"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Retrieve a stored article by its API ID.",
        "tags": [
          "articles"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "article_id",
          "required": true,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ]
    },
    "/api/v1/scrape-runs": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "422": {
            "description": "Invalid limit"
          },
          "503": {
            "description": "Administration is not configured or database unavailable"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List recent completed scrape attempts.",
        "tags": [
          "scrape_runs"
        ]
      },
      "post": {
        "description": "No request body. Returns after completion (normally within 90 seconds).\nA created run can be succeeded, partial, or failed; inspect status and\ncounters even on HTTP 201. At most 40 article requests per run.",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Location": {
                "description": "Created run URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "409": {
            "description": "Another scrape holds the PostgreSQL transaction lock"
          },
          "503": {
            "description": "Administration is not configured or database unavailable"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create and execute a bounded scrape run synchronously.",
        "tags": [
          "scrape_runs"
        ]
      }
    },
    "/api/v1/scrape-runs/{run_id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Run not found"
          },
          "503": {
            "description": "Administration is not configured or database unavailable"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Retrieve the result of a scrape attempt.",
        "tags": [
          "scrape_runs"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "run_id",
          "required": true,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ]
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Database is unavailable or migrations are missing"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Check database connectivity and article table readiness.",
        "tags": [
          "health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Collected English articles",
      "name": "articles"
    },
    {
      "description": "Authenticated collection operations",
      "name": "scrape_runs"
    },
    {
      "description": "Database readiness",
      "name": "health"
    }
  ]
}
